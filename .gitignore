# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# from backend, containing any docs for progressing
/docs

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!frontend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local knowledge graph, extraction cache, and reports
/graphify-out/

.claude/
.mcp.json

# Local backend handover notes
/BACKEND_HANDOVER.md

# clasp project binding and credentials (per account)
.clasp.json
.clasprc.json

# Local Apps Script Script Properties (contain the ingestion secret)
backend/apps-script/*.local.json
