# Next.js loads server environment from frontend/, not backend/.
# Copy to frontend/.env.local. Never use NEXT_PUBLIC_ for these values.
# Auth mutations require Atlas or a replica set, not a standalone server.
# Local development: run `pnpm db:up` (Docker single-node replica set).
# directConnection=true avoids resolving the container-internal member host.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=kmits

# Leave empty to disable internal ingestion. When configuring it, use a random
# secret of at least 32 characters shared only with the Apps Script connector.
# The same secret authenticates Archive, Timeline and Article ingestion.
APPS_SCRIPT_INGESTION_SECRET=

# Optional. Maximum JSON request body in bytes (1024-16777216). Default 262144.
API_MAX_JSON_BYTES=

# Local admin login. Exact origin is required for login and admin mutations.
APP_ORIGIN=http://localhost:3000
# Initial provisioning only. Choose your own username/password, run bootstrap
# once, then remove both values. No default credentials are provided.
BOOTSTRAP_SUPER_ADMIN_USERNAME=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Register permitted Archive sources. Run pnpm archives:setup before ingestion.
# Example: [{"streamId":"ministry-one","ministryId":"ministry-one","folderId":"DRIVE_FOLDER_ID"}]
# A stream/sequence namespace must remain stable across connector restarts.
ARCHIVE_SOURCE_CONFIG=[]

# Server-only PDF reader. Share ONLY the registered folders with this separate
# service-account identity as Viewer. Enable Drive API in its Google project.
# Use literal \n for private-key line breaks; never use NEXT_PUBLIC_ secrets.
DRIVE_SERVICE_ACCOUNT_EMAIL=
DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
# API key for anonymous readability checks, restricted to Drive API and the
# deployment's server IP where possible. It does not grant document permissions.
DRIVE_PUBLIC_API_KEY=

# Timeline: the one shared Google Calendar ID, e.g. xyz@group.calendar.google.com.
# Required for /api/events and event sync. Run pnpm timeline:setup afterwards.
EVENT_CALENDAR_ID=
# Optional Timeline limits. Leave empty for the default shown.
# Events per sync request, 1-500. Default 50.
EVENT_SYNC_MAX_ITEMS=
# Event description length, 1-100000. Default 8000.
EVENT_DESCRIPTION_MAX_CHARS=
# Page size default and maximum for event lists, 1-1000. Defaults 50 and 200.
EVENT_PAGE_DEFAULT_LIMIT=
EVENT_PAGE_MAX_LIMIT=

# Articles: the Google Form ID that feeds article submissions.
# Required for /api/articles and article sync. Run pnpm articles:setup afterwards.
ARTICLE_FORM_ID=
# Optional Article limits. Leave empty for the default shown.
# Submissions per sync request, 1-500. Default 20.
ARTICLE_SYNC_MAX_ITEMS=
# Summary length 1-100000 (default 1000) and Markdown body length 1-1000000
# (default 50000). Raise API_MAX_JSON_BYTES too when raising the body limit.
ARTICLE_SUMMARY_MAX_CHARS=
ARTICLE_BODY_MAX_CHARS=
# Page size default and maximum for article lists, 1-1000. Defaults 20 and 100.
ARTICLE_PAGE_DEFAULT_LIMIT=
ARTICLE_PAGE_MAX_LIMIT=
