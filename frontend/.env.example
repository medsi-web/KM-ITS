# Next.js loads server environment from frontend/, not backend/.
# Copy to frontend/.env.local. Never use NEXT_PUBLIC_ for these values.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=kmits

# Leave empty to disable internal ingestion. When configuring it, use a random
# secret of at least 32 characters shared only with the Apps Script connector.
# Transport authentication is ready; ingestion itself is NOT implemented yet.
APPS_SCRIPT_INGESTION_SECRET=

# Admin login (configure a Google OAuth Web application; no Drive/Calendar scopes).
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-only initial provisioning. Fill in your own Google email, run bootstrap
# once, then remove this value. Never commit your real address or credentials.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
