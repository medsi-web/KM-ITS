{
  "name": "km-its",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @kmits/frontend dev",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose stop mongo",
    "db:logs": "docker compose logs -f mongo",
    "build": "pnpm --filter @kmits/backend typecheck && pnpm --filter @kmits/frontend build",
    "start": "pnpm --filter @kmits/frontend start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @kmits/backend test",
    "test:integration": "pnpm --filter @kmits/backend test:integration",
    "test:http": "pnpm --filter @kmits/backend test:http",
    "test:auth": "pnpm --filter @kmits/backend test:auth",
    "auth:setup": "pnpm --filter @kmits/backend auth:setup",
    "auth:bootstrap": "pnpm --filter @kmits/backend auth:bootstrap",
    "auth:hash": "pnpm --filter @kmits/backend auth:hash",
    "auth:migrate": "pnpm --filter @kmits/backend auth:migrate",
    "archives:setup": "pnpm --filter @kmits/backend archives:setup",
    "timeline:setup": "pnpm --filter @kmits/backend timeline:setup",
    "articles:setup": "pnpm --filter @kmits/backend articles:setup",
    "test:archives": "pnpm --filter @kmits/backend test:archives",
    "test:timeline": "pnpm --filter @kmits/backend test:timeline",
    "test:articles": "pnpm --filter @kmits/backend test:articles",
    "api:generate": "pnpm --filter @kmits/backend api:generate",
    "api:check": "pnpm --filter @kmits/backend api:check",
    "test:api": "pnpm --filter @kmits/backend test:api"
  },
  "engines": { "node": ">=24.0.0" },
  "packageManager": "pnpm@12.11.2"
}
