{
  "name": "km-its",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @kmits/frontend dev",
    "build": "pnpm --filter @kmits/backend typecheck && pnpm --filter @kmits/frontend build",
    "start": "pnpm --filter @kmits/frontend start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @kmits/backend test",
    "api:generate": "pnpm --filter @kmits/backend api:generate",
    "api:check": "pnpm --filter @kmits/backend api:check",
    "test:api": "pnpm --filter @kmits/backend test:api"
  },
  "engines": { "node": ">=24.0.0" },
  "packageManager": "pnpm@12.11.2"
}
