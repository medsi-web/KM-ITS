{
  "name": "@kmits/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/auth.integration.ts",
    "auth:setup": "node --env-file-if-exists=../frontend/.env.local scripts/setup-auth.mjs",
    "auth:bootstrap": "node --env-file-if-exists=../frontend/.env.local scripts/setup-auth.mjs --bootstrap",
    "api:generate": "node scripts/generate-api-kit.mjs",
    "api:check": "node scripts/generate-api-kit.mjs --check",
    "test:api": "newman run postman/KMITS.postman_collection.json -e postman/Local.postman_environment.json --timeout-request 10000 --reporter-cli-no-assertions"
  },
  "dependencies": {
    "google-auth-library": "^11.3.2",
    "mongodb": "^7.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0"
  }
}
