{
  "name": "@kmits/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=tests/fixtures/test.env --test tests/*.test.ts",
    "test:integration": "node --env-file=tests/fixtures/test.env --test tests/*.integration.ts",
    "test:http": "node scripts/test-http-auth.mjs",
    "test:auth": "newman run postman/Auth.postman_collection.json -e postman/Local.postman_environment.json --bail --timeout-request 10000 --reporter-cli-no-assertions",
    "auth:setup": "node --env-file-if-exists=../frontend/.env.local scripts/setup-auth.mjs",
    "auth:bootstrap": "node --env-file-if-exists=../frontend/.env.local scripts/setup-auth.mjs --bootstrap",
    "auth:hash": "node scripts/hash-password.mjs",
    "integration:secret": "node scripts/ingestion-secret.mjs",
    "auth:migrate": "node --env-file-if-exists=../frontend/.env.local scripts/migrate-auth.mjs",
    "archives:setup": "node --env-file-if-exists=../frontend/.env.local scripts/setup-feature.mjs archives",
    "timeline:setup": "node --env-file-if-exists=../frontend/.env.local scripts/setup-feature.mjs timeline",
    "articles:setup": "node --env-file-if-exists=../frontend/.env.local scripts/setup-feature.mjs articles",
    "test:archives": "newman run postman/Archive.postman_collection.json -e postman/Local.postman_environment.json --bail --timeout-request 10000 --reporter-cli-no-assertions",
    "test:timeline": "newman run postman/Timeline.postman_collection.json -e postman/Local.postman_environment.json --bail --timeout-request 10000 --reporter-cli-no-assertions",
    "test:articles": "newman run postman/Articles.postman_collection.json -e postman/Local.postman_environment.json --bail --timeout-request 10000 --reporter-cli-no-assertions",
    "api:generate": "node scripts/generate-api-kit.mjs",
    "api:check": "node scripts/generate-api-kit.mjs --check",
    "test:api": "newman run postman/KMITS.postman_collection.json -e postman/Local.postman_environment.json --timeout-request 10000 --reporter-cli-no-assertions"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "mongodb": "^7.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0"
  }
}
