{
  "info": {
    "name": "KM ITS - Archive Workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local temporary database only. Requires a ready super-admin username/password and the ingestion secret. Exercises ingestion, public metadata, admin hide/unhide and sync logs. Drive credentials must be unset for the configured open failure assertion. Use a fresh database for each run."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?$/.test(pm.environment.get(\"baseUrl\") || \"\")) throw new Error(\"Local test server required\");"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"JSON envelope\", () => { const b = pm.response.json(); pm.expect(b.success).to.eql(pm.response.code < 400); pm.expect(b.meta.requestId).to.match(/^[0-9a-f-]{36}$/); pm.expect(Date.parse(b.meta.timestamp)).not.to.be.NaN; pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.eql(b.meta.requestId); });",
          "pm.test(\"No caching\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login archive operator",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const d = pm.response.json().data; const c = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).join(\"; \").match(/(?:__Host-)?kmits_session=[A-Za-z0-9_-]{43}/); pm.test(\"Session cookie exists\", () => pm.expect(c).not.to.eql(null)); if(c) pm.environment.set(\"sessionCookie\", c[0]); pm.environment.set(\"csrfToken\", d.csrfToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Sync a valid archive",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/internal/sync/archives",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ingestionSecret}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"protocolVersion\":1,\"streamId\":\"http-test-stream\",\"deliveryId\":\"http-delivery-1\",\"scanSequence\":\"1\",\"metadataFileId\":\"http-metadata\",\"metadataDriveVersion\":\"1\",\"observation\":\"VALID\",\"sourceCheckedAt\":\"2026-01-01T00:00:00.000Z\",\"folderId\":\"http-folder\",\"metadata\":{\"schemaVersion\":1,\"driveFileId\":\"http-pdf\",\"title\":\"HTTP archive fixture\",\"description\":\"Temporary test document\",\"category\":\"Reports\",\"year\":2026,\"authors\":[\"Test ministry\"]},\"pdf\":{\"driveFileId\":\"http-pdf\",\"folderId\":\"http-folder\",\"mimeType\":\"application/pdf\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"publicReadable\":true,\"size\":100}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Applied\",()=>pm.expect(pm.response.json().data.outcome).to.eql(\"applied\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate delivery is idempotent",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/internal/sync/archives",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ingestionSecret}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"protocolVersion\":1,\"streamId\":\"http-test-stream\",\"deliveryId\":\"http-delivery-1\",\"scanSequence\":\"1\",\"metadataFileId\":\"http-metadata\",\"metadataDriveVersion\":\"1\",\"observation\":\"VALID\",\"sourceCheckedAt\":\"2026-01-01T00:00:00.000Z\",\"folderId\":\"http-folder\",\"metadata\":{\"schemaVersion\":1,\"driveFileId\":\"http-pdf\",\"title\":\"HTTP archive fixture\",\"description\":\"Temporary test document\",\"category\":\"Reports\",\"year\":2026,\"authors\":[\"Test ministry\"]},\"pdf\":{\"driveFileId\":\"http-pdf\",\"folderId\":\"http-folder\",\"mimeType\":\"application/pdf\",\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"publicReadable\":true,\"size\":100}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Duplicate\",()=>pm.expect(pm.response.json().data.outcome).to.eql(\"duplicate\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Public archive list",
