            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data; pm.test(\"Visible fixture\",()=>pm.expect(d.total).to.eql(1)); pm.environment.set(\"archiveId\",d.items[0].id); pm.test(\"Private source omitted\",()=>{pm.expect(d.items[0]).not.to.have.property(\"sourceFolderId\");pm.expect(d.items[0]).not.to.have.property(\"snapshot\");});"
            ]
          }
        }
      ]
