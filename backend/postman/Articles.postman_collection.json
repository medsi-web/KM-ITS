{
  "info": {
    "name": "KM ITS - Articles Workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local temporary database only. Requires a ready super-admin, the ingestion secret and formId equal to ARTICLE_FORM_ID. Exercises unpublished ingestion, revision-checked publish, draft editing, source updates and unpublish. Use a fresh database for each run."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?$/.test(pm.environment.get(\"baseUrl\") || \"\")) throw new Error(\"Local test server required\");"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"JSON envelope\", () => { const b = pm.response.json(); pm.expect(b.success).to.eql(pm.response.code < 400); pm.expect(b.meta.requestId).to.match(/^[0-9a-f-]{36}$/); pm.expect(Date.parse(b.meta.timestamp)).not.to.be.NaN; pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.eql(b.meta.requestId); });",
          "pm.test(\"No caching\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login article reviewer",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const d = pm.response.json().data; const c = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).join(\"; \").match(/(?:__Host-)?kmits_session=[A-Za-z0-9_-]{43}/); pm.test(\"Session cookie exists\", () => pm.expect(c).not.to.eql(null)); if(c) pm.environment.set(\"sessionCookie\", c[0]); pm.environment.set(\"csrfToken\", d.csrfToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Sync submission",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/internal/sync/articles",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ingestionSecret}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"protocolVersion\":1,\"formId\":\"{{formId}}\",\"submissions\":[{\"responseId\":\"http-response\",\"submittedAt\":\"2026-01-01T00:00:00.000Z\",\"submitterEmail\":\"contributor@example.com\",\"article\":{\"schemaVersion\":1,\"title\":\"First title\",\"summary\":\"Fixture summary\",\"category\":\"News\",\"ministry\":\"Test ministry\",\"authors\":[\"Contributor\"],\"coverImage\":{\"driveFileId\":\"cover-image-id\",\"alt\":\"Cover\"},\"body\":\"## Fixture\\n\\nArticle body.\"}}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Outcomes\", () => pm.expect(pm.response.json().data.results.map(r => r.outcome)).to.eql([\"applied\"]));"
            ]
          }
        }
      ]
    },
