{
  "info": {
    "name": "KM ITS - Auth and Archive Workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Destructive localhost-only workflow for a fresh temporary database. Real HTTP login, temporary credentials, reset, sync, visibility and logout. Use scripts/test-http-auth.mjs. Never use production credentials."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?$/.test(pm.environment.get(\"baseUrl\") || \"\")) throw new Error(\"Local test server required\");"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"JSON envelope\", () => { const b = pm.response.json(); pm.expect(b.success).to.eql(pm.response.code < 400); pm.expect(b.meta.requestId).to.match(/^[0-9a-f-]{36}$/); pm.expect(Date.parse(b.meta.timestamp)).not.to.be.NaN; pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.eql(b.meta.requestId); });",
          "pm.test(\"No caching\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login with actual bootstrap credentials",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const d = pm.response.json().data; const c = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).join(\"; \").match(/(?:__Host-)?kmits_session=[A-Za-z0-9_-]{43}/); pm.test(\"Session cookie exists\", () => pm.expect(c).not.to.eql(null)); if(c) pm.environment.set(\"sessionCookie\", c[0]); pm.environment.set(\"csrfToken\", d.csrfToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Fixed 24-hour session",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": [
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"24h bound\", () => { const remaining = Date.parse(pm.response.json().data.expiresAt) - Date.now(); pm.expect(remaining).to.be.above(86300000); pm.expect(remaining).to.be.at.most(86400000); });"
            ]
          }
        }
      ]
    },
