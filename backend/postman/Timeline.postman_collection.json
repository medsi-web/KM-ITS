              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Total 2\", () => pm.expect(pm.response.json().data.total).to.eql(2));",
              "const d = pm.response.json().data; pm.test(\"Derived status\", () => pm.expect(d.items.map(e => e.status)).to.eql([\"FINISHED\", \"UPCOMING\"])); pm.environment.set(\"eventId\", d.items[1].id); pm.test(\"Source identity omitted\", () => pm.expect(d.items[0]).not.to.have.property(\"calendarId\"));"
            ]
