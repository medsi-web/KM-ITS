{
  "info": {
    "name": "KM ITS - Timeline Workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local temporary database only. Requires a ready super-admin, the ingestion secret and calendarId equal to EVENT_CALENDAR_ID. Exercises batch sync ordering, public window/status filters, admin hiding and sync logs. Use a fresh database for each run."
  },
  "item": [
    {
      "name": "Login timeline operator",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const d = pm.response.json().data; const c = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).join(\"; \").match(/(?:__Host-)?kmits_session=[A-Za-z0-9_-]{43}/); pm.test(\"Session cookie exists\", () => pm.expect(c).not.to.eql(null)); if(c) pm.environment.set(\"sessionCookie\", c[0]); pm.environment.set(\"csrfToken\", d.csrfToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Sync event batch",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/internal/sync/events",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ingestionSecret}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"protocolVersion\":1,\"calendarId\":\"{{calendarId}}\",\"events\":[{\"eventId\":\"tl-past\",\"updated\":\"2026-01-01T00:00:00.000Z\",\"status\":\"confirmed\",\"title\":\"Timeline tl-past\",\"description\":\"Fixture\",\"location\":\"ITS\",\"organization\":\"Test ministry\",\"allDay\":false,\"startAt\":\"2020-01-01T00:00:00.000Z\",\"endAt\":\"2020-01-02T00:00:00.000Z\"},{\"eventId\":\"tl-future\",\"updated\":\"2026-01-01T00:00:00.000Z\",\"status\":\"confirmed\",\"title\":\"Timeline tl-future\",\"description\":\"Fixture\",\"location\":\"ITS\",\"organization\":\"Test ministry\",\"allDay\":true,\"startAt\":\"2099-01-01T00:00:00.000Z\",\"endAt\":\"2099-01-02T00:00:00.000Z\"},{\"eventId\":\"tl-cancelled\",\"updated\":\"2026-01-01T00:00:00.000Z\",\"status\":\"cancelled\"}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Outcomes\", () => pm.expect(pm.response.json().data.results.map(r => r.outcome)).to.eql([\"applied\",\"applied\",\"applied\"]));"
            ]
          }
        }
      ]
    },
